@prefix : <http://example.org/examples/undodelete#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Undo after deleting a class restores everything about it (issue #77): its comment, annotation,
# subclass axiom and data restriction (the "title [1..1]" box), the ∀ restriction from Room
# ("∀ hasPart", read-only) and the ∃ edge from Room ("∃ faces [1..*]"). Before, only the label came back.
#
# Try it: click Wall, press Delete, then Undo. Wall, its "title" box and the three relationships
# (Wall → Thing, Room → Wall "∀ hasPart" and "∃ faces [1..*]") are back; Save writes the file unchanged.

<http://example.org/examples/undodelete> rdf:type owl:Ontology ;
    rdfs:label "Undo a class delete" .

:note rdf:type owl:AnnotationProperty .
:hasPart rdf:type owl:ObjectProperty .
:faces rdf:type owl:ObjectProperty .
:title rdf:type owl:DatatypeProperty .

:Thing rdf:type owl:Class ;
    rdfs:label "Thing" .

:Wall rdf:type owl:Class ;
    rdfs:label "Wall"@en ;
    rdfs:comment "A vertical element." ;
    :note "checked" ;
    rdfs:subClassOf :Thing ,
        [ rdf:type owl:Restriction ; owl:onProperty :title ; owl:onDataRange xsd:string ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

:Room rdf:type owl:Class ;
    rdfs:label "Room" ;
    rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty :hasPart ; owl:allValuesFrom :Wall ] ,
        [ rdf:type owl:Restriction ; owl:onProperty :faces ; owl:someValuesFrom :Wall ] .
