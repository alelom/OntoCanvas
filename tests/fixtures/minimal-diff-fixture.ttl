@prefix : <http://example.org/mdf#>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.

#################################################################
#    Ontology
#################################################################

:Ontology rdf:type owl:Ontology ;
    rdfs:comment "A minimal fixture for testing atomic-diff serialization." ;
    rdfs:label "Minimal Diff Fixture" .


#################################################################
#    Annotation properties
#################################################################

:labellableRoot rdf:type owl:AnnotationProperty ;
    rdfs:comment "When true, this class can be used as a label." ;
    rdfs:label "Labellable root" ;
    rdfs:range xsd:boolean.


#################################################################
#    Object Properties
#################################################################

:contains rdf:type owl:ObjectProperty ;
    rdfs:comment "Containment relationship." ;
    rdfs:label "contains" ;
    rdfs:range owl:Thing ;
    rdfs:domain owl:Thing.


#################################################################
#    Classes
#################################################################

:Building rdf:type owl:Class ;
    rdfs:label "Building" ;
    rdfs:comment "A structure with walls and a roof." .

:Floor rdf:type owl:Class ;
    rdfs:label "Floor" .

:Room rdf:type owl:Class ;
    rdfs:subClassOf :Floor,
        [ rdf:type owl:Restriction ; owl:onProperty :contains ; owl:onClass :Building ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    rdfs:label "Room" ;
    rdfs:comment "An enclosed space within a building." ;
    :labellableRoot "true"^^xsd:boolean .

:Wall rdf:type owl:Class ;
    rdfs:subClassOf :Building ;
    rdfs:label "Wall" ;
    :labellableRoot "false"^^xsd:boolean .
