@prefix : <http://example.org/mdp#>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.

#################################################################
#    Ontology
#################################################################

:Ontology rdf:type owl:Ontology ;
    rdfs:comment "Fixture for property/annotation atomic-diff tests." ;
    rdfs:label "Minimal Diff Properties Fixture" .


#################################################################
#    Annotation properties
#################################################################

:exampleImage rdf:type owl:AnnotationProperty ;
    rdfs:comment "Links a class to an example image."@en ;
    rdfs:label "example image"@en.

:labellableRoot rdf:type owl:AnnotationProperty ;
    rdfs:comment "When true, this class can be used as a label." ;
    rdfs:label "Labellable root" ;
    rdfs:range xsd:boolean.


#################################################################
#    Object Properties
#################################################################

:relatesTo rdf:type owl:ObjectProperty ;
    rdfs:label "relates to" ;
    rdfs:comment "Generic association." ;
    rdfs:range owl:Thing ;
    rdfs:domain owl:Thing.

:hasPart rdf:type owl:ObjectProperty ;
    rdfs:label "has part" ;
    rdfs:comment "Composition relationship." ;
    rdfs:range :Zone ;
    rdfs:domain :Site.


#################################################################
#    Data properties
#################################################################

:hasArea rdf:type owl:DatatypeProperty ;
    rdfs:label "has area" ;
    rdfs:comment "Floor area in square metres." ;
    rdfs:range xsd:decimal ;
    rdfs:domain :Zone.


#################################################################
#    Classes
#################################################################

:Site rdf:type owl:Class ;
    rdfs:label "Site" ;
    rdfs:comment "A parcel of land." ;
    :exampleImage <https://example.org/img/site.png> ;
    :labellableRoot "true"^^xsd:boolean .

:Zone rdf:type owl:Class ;
    rdfs:label "Zone" ;
    rdfs:comment "A subdivision of a site." .

:Region rdf:type owl:Class ;
    rdfs:label "Region" .

:District rdf:type owl:Class ;
    rdfs:label "District" .
